---
import App from '../components/codex/App';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import type { Log } from '../types';
import logUpdatedDates from '../data/log-updated-dates.json';
import { promises as fs } from 'node:fs';
import path from 'node:path';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const rawLogs = await getCollection('logs');
const logsHtml: Record<string, string> = {};

// Render draft markdown with the SAME engine Astro uses for published logs
// (@astrojs/markdown-remark), mirroring the shikiConfig from astro.config.mjs so
// headings, lists, code blocks, emphasis, links, etc. come out identical to the
// collection-rendered entries. Created once and reused across all draft files.
let draftMarkdownProcessor: Awaited<ReturnType<typeof createMarkdownProcessor>> | null = null;
async function getDraftMarkdownProcessor() {
  if (!draftMarkdownProcessor) {
    draftMarkdownProcessor = await createMarkdownProcessor({
      shikiConfig: {
        langs: [
          { name: 'bash-prompt',     scopeName: 'source.bash-prompt',     patterns: [], repository: {} },
          { name: 'bash-prompt-key', scopeName: 'source.bash-prompt-key', patterns: [], repository: {} },
          { name: 'wrap',            scopeName: 'source.wrap',            patterns: [], repository: {} },
        ],
      },
    });
  }
  return draftMarkdownProcessor;
}

// Helper: parse YAML frontmatter (simple regex-based parser)
function parseFrontmatter(content: string) {
  const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (!match) return { data: {}, body: content };

  const yamlStr = match[1];
  const body = content.slice(match[0].length).trim();

  // Simple YAML parser for frontmatter
  const data: Record<string, any> = {};
  yamlStr.split('\n').forEach(line => {
    const [key, ...valueParts] = line.split(':');
    if (key && valueParts.length) {
      const value = valueParts.join(':').trim();
      // Handle quoted strings and basic types
      if (value.startsWith('"') && value.endsWith('"')) {
        data[key.trim()] = value.slice(1, -1);
      } else if (value.startsWith('[') && value.endsWith(']')) {
        data[key.trim()] = JSON.parse(value);
      } else if (value === 'true') {
        data[key.trim()] = true;
      } else if (value === 'false') {
        data[key.trim()] = false;
      } else {
        data[key.trim()] = value;
      }
    }
  });

  return { data, body };
}

// Helper: load drafts from logs-drafts folder (dev-only, git-ignored)
async function loadDraftsFolder() {
  const draftsDir = path.resolve(process.cwd(), 'src/content/logs-drafts');
  try {
    const files = await fs.readdir(draftsDir);
    const mdFiles = files.filter(f => f.endsWith('.md'));

    const draftEntries = await Promise.all(
      mdFiles.map(async (filename) => {
        const content = await fs.readFile(path.join(draftsDir, filename), 'utf-8');
        const { data, body } = parseFrontmatter(content);
        // Render full markdown (headings, lists, code blocks, emphasis, links, …)
        // through Astro's own processor so drafts match published logs exactly.
        const processor = await getDraftMarkdownProcessor();
        const html = (await processor.render(body)).code;

        return {
          id: `logs-drafts/${filename.replace(/\.md$/, '')}`,
          rendered: { html },
          data: {
            title: data.title || filename.replace(/\.md$/, ''),
            date: data.date || new Date().toISOString().split('T')[0],
            kicker: data.kicker,
            tags: data.tags,
            image: data.image,
            hook: data.hook,
            devto: data.devto,
            series: data.series,
            noThumb: data.noThumb,
            mentor: data.mentor,
          },
        };
      })
    );
    return draftEntries;
  } catch (err) {
    // Folder doesn't exist or can't be read — that's fine, return empty
    return [];
  }
}

// Word count: for tab groups, count only the longest tab — a reader only reads one path.
// Uses a depth-aware parser so nested tab groups are handled correctly at every level.
function findClosingDiv(html: string, start: number): number {
  let depth = 1;
  let i = start;
  while (i < html.length && depth > 0) {
    if (html.startsWith('</div>', i)) {
      depth--;
      if (depth === 0) return i;
      i += 6;
    } else if (html.startsWith('<div', i) && (html[i + 4] === '>' || html[i + 4] === ' ')) {
      depth++;
      i += 4;
    } else {
      i++;
    }
  }
  return -1;
}

function longestTabOnly(html: string): string {
  const OPEN = '<div class="pw-tabs-raw">';
  const SEP_RE = /<div class="pw-tab-sep"[^>]*><\/div>/g;
  const textLen = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().length;
  let result = '';
  let i = 0;
  while (i < html.length) {
    const tabStart = html.indexOf(OPEN, i);
    if (tabStart === -1) { result += html.slice(i); break; }
    result += html.slice(i, tabStart);
    const innerStart = tabStart + OPEN.length;
    const closeIdx = findClosingDiv(html, innerStart);
    if (closeIdx === -1) { result += html.slice(tabStart); break; }
    const inner = html.slice(innerStart, closeIdx);
    // Split inner content on tab separators
    const parts: string[] = [];
    let last = 0;
    SEP_RE.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = SEP_RE.exec(inner)) !== null) { parts.push(inner.slice(last, m.index)); last = m.index + m[0].length; }
    parts.push(inner.slice(last));
    const tabs = parts.slice(1); // index 0 is pre-first-separator preamble
    if (tabs.length === 0) {
      result += html.slice(tabStart, closeIdx + 6);
    } else {
      const longest = tabs.reduce((a, b) => textLen(b) > textLen(a) ? b : a, tabs[0]);
      result += longestTabOnly(longest); // recurse for nested groups in winner
    }
    i = closeIdx + 6;
  }
  return result;
}

// Load both published logs and draft logs
const draftLogs = import.meta.env.DEV ? await loadDraftsFolder() : [];
const allLogs = [...rawLogs, ...draftLogs];
const rawEntries = allLogs.map((entry) => {
  // Drafts arrive with a `logs-drafts/` or `drafts/` path prefix (dev only). Strip it
  // so the slug behaves like any other log, and carry a `draft` flag through for the badge.
  const rawId = entry.id.replace(/\.md$/, '');
  const draft = rawId.startsWith('logs-drafts/') || rawId.startsWith('drafts/');
  const id = rawId.replace(/^(?:logs-drafts|drafts)\//, '');
  const html = entry.rendered?.html ?? '';
  logsHtml[id] = html;
  const words = longestTabOnly(html).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().split(' ').filter(Boolean).length;
  const hook = entry.data.hook ?? (html.match(/<p[^>]*>([\s\S]*?)<\/p>/)?.[1].replace(/<[^>]+>/g, "").trim() || undefined);
  return { id, draft, title: entry.data.title, date: entry.data.date, kicker: entry.data.kicker, words, tags: entry.data.tags, image: entry.data.image, hook, devto: entry.data.devto, seriesRaw: entry.data.series, noThumb: entry.data.noThumb, mentor: entry.data.mentor };
});

// Group articles that belong to a series
const seriesGroups = new Map<string, typeof rawEntries>();
for (const e of rawEntries) {
  if (e.seriesRaw) {
    const g = seriesGroups.get(e.seriesRaw.name) ?? [];
    g.push(e);
    seriesGroups.set(e.seriesRaw.name, g);
  }
}

// For each series group: sort by explicit part then by date, assign sequential parts
// total = max(actual article count, any frontmatter-specified intended total)
const assignedParts = new Map<string, number>(); // id -> computed part
const seriesTotals = new Map<string, number>();   // name -> intended total

for (const [name, members] of seriesGroups) {
  members.sort((a, b) => {
    const pa = a.seriesRaw?.part, pb = b.seriesRaw?.part;
    if (pa != null && pb != null) return pa - pb;
    if (pa != null) return -1;
    if (pb != null) return 1;
    return a.date.localeCompare(b.date);
  });
  members.forEach((m, i) => assignedParts.set(m.id, i + 1));

  const latestEntry = members[members.length - 1];
  const specifiedTotal = latestEntry.seriesRaw?.total ?? 0;
  seriesTotals.set(name, Math.max(members.length, specifiedTotal));
}

const logUpdated = logUpdatedDates as Record<string, string>;

const logs: Log[] = rawEntries.map((e) => ({
  id: e.id,
  draft: e.draft,
  title: e.title,
  date: e.date,
  updated: logUpdated[e.id],
  kicker: e.kicker,
  words: e.words,
  tags: e.tags,
  image: e.image,
  hook: e.hook,
  devto: e.devto,
  series: e.seriesRaw
    ? { name: e.seriesRaw.name, part: assignedParts.get(e.id)!, total: seriesTotals.get(e.seriesRaw.name)! }
    : undefined,
  noThumb: e.noThumb,
  mentor: e.mentor,
})).sort((a, b) => b.date.localeCompare(a.date));
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Phillip Wessels · CODEX</title>
  <meta name="description" content="Phillip Wessels — Full-Stack Developer. React, TypeScript, Node." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://pawper.dev/" />
  <meta property="og:title" content="Phillip Wessels · CODEX" />
  <meta property="og:description" content="Phillip Wessels — Full-Stack Developer. React, TypeScript, Node." />
  <meta property="og:site_name" content="pawper.dev · CODEX" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Phillip Wessels · CODEX" />
  <meta name="twitter:description" content="Phillip Wessels — Full-Stack Developer. React, TypeScript, Node." />

  <!-- WebMCP: registers read-only in-page tools for AI agents (no-op without navigator.modelContext) -->
  <script src="/webmcp.js" defer></script>
</head>
<body>
  <!-- Hidden form lets Netlify's build bot register the contact form for processing -->
  <form name="contact" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
    <input type="text"  name="name" />
    <input type="email" name="email" />
    <input type="text"  name="subject" />
    <textarea name="message"></textarea>
    <input name="bot-field" />
  </form>
  <div id="app-root" style="min-height: 100dvh;">
    <App client:only="react" logsHtml={logsHtml} logs={logs} />
  </div>
</body>
</html>
