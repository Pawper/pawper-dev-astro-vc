  <meta property="og:title" content="Phillip Wessels · CODEX" />
  <meta property="og:description" content="Phillip Wessels — Full-Stack Developer. React, TypeScript, Node." />
  <meta property="og:site_name" content="pawper.dev · CODEX" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Phillip Wessels · CODEX" />
  <meta name="twitter:description" content="Phillip Wessels — Full-Stack Developer. React, TypeScript, Node." />
</head>
<body>
  <!-- Hidden form lets Netlify's build bot register the contact form for processing -->
  <form name="contact" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
    <input type="text"  name="name" />
    <input type="email" name="email" />
    <input type="text"  name="subject" />
    <textarea name="message"></textarea>
    <input name="bot-field" />
  </form>
  <div id="app-root" style="min-height: 100dvh;">
    <App client:only="react" logsHtml={logsHtml} logs={logs} />
  </div>
</body>
</html>
