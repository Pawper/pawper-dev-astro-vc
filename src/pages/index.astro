---
import App from '../components/codex/App';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import type { Log } from '../types';
import logUpdatedDates from '../data/log-updated-dates.json';
import { promises as fs } from 'node:fs';
import path from 'node:path';

const rawLogs = await getCollection('logs');
const logsHtml: Record<string, string> = {};

// Helper: parse YAML frontmatter (simple regex-based parser)
function parseFrontmatter(content: string) {
  const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (!match) return { data: {}, body: content };

  const yamlStr = match[1];
  const body = content.slice(match[0].length).trim();

  // Simple YAML parser for frontmatter
  const data: Record<string, any> = {};
  yamlStr.split('\n').forEach(line => {
    const [key, ...valueParts] = line.split(':');
    if (key && valueParts.length) {
      const value = valueParts.join(':').trim();
      // Handle quoted strings and basic types
      if (value.startsWith('"') && value.endsWith('"')) {
        data[key.trim()] = value.slice(1, -1);
      } else if (value.startsWith('[') && value.endsWith(']')) {
        data[key.trim()] = JSON.parse(value);
      } else if (value === 'true') {
        data[key.trim()] = true;
      } else if (value === 'false') {
        data[key.trim()] = false;
      } else {
        data[key.trim()] = value;
      }
    }
  });

  return { data, body };
}

// Helper: load drafts from logs-drafts folder (dev-only, git-ignored)
async function loadDraftsFolder() {
  const draftsDir = path.resolve(process.cwd(), 'src/content/logs-drafts');
  try {
    const files = await fs.readdir(draftsDir);
    const mdFiles = files.filter(f => f.endsWith('.md'));

    const draftEntries = await Promise.all(
      mdFiles.map(async (filename) => {
        const content = await fs.readFile(path.join(draftsDir, filename), 'utf-8');
        const { data, body } = parseFrontmatter(content);
        // Simple HTML conversion: convert markdown paragraphs to HTML
        // This is a minimal conversion just for hook extraction and word counting
        const html = body
          .split('\n\n')
          .map(p => p.trim() ? `<p>${p.replace(/\n/g, '<br>')}</p>` : '')
          .join('\n');

        return {
          id: `logs-drafts/${filename.replace(/\.md$/, '')}`,
          rendered: { html },
          data: {
            title: data.title || filename.replace(/\.md$/, ''),
            date: data.date || new Date().toISOString().split('T')[0],
            kicker: data.kicker,
            tags: data.tags,
            image: data.image,
            hook: data.hook,
            devto: data.devto,
            series: data.series,
            noThumb: data.noThumb,
            mentor: data.mentor,
          },
        };
      })
    );
    return draftEntries;
  } catch (err) {
    // Folder doesn't exist or can't be read — that's fine, return empty
    return [];
  }
}

// Load both published logs and draft logs
const draftLogs = import.meta.env.DEV ? await loadDraftsFolder() : [];
const allLogs = [...rawLogs, ...draftLogs];
const rawEntries = allLogs.map((entry) => {
  // Drafts arrive with a `logs-drafts/` path prefix (dev only). Strip it so the
  // slug behaves like any other log, and carry a `draft` flag through for the badge.
  const rawId = entry.id.replace(/\.md$/, '');
  const draft = rawId.startsWith('logs-drafts/');
  const id = draft ? rawId.replace(/^logs-drafts\//, '') : rawId;
  const html = entry.rendered?.html ?? '';
  logsHtml[id] = html;
  const words = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().split(' ').filter(Boolean).length;
  const hook = entry.data.hook ?? (html.match(/<p[^>]*>([\s\S]*?)<\/p>/)?.[1].replace(/<[^>]+>/g, "").trim() || undefined);
  return { id, draft, title: entry.data.title, date: entry.data.date, kicker: entry.data.kicker, words, tags: entry.data.tags, image: entry.data.image, hook, devto: entry.data.devto, seriesRaw: entry.data.series, noThumb: entry.data.noThumb, mentor: entry.data.mentor };
});

// Group articles that belong to a series
const seriesGroups = new Map<string, typeof rawEntries>();
for (const e of rawEntries) {
  if (e.seriesRaw) {
    const g = seriesGroups.get(e.seriesRaw.name) ?? [];
    g.push(e);
    seriesGroups.set(e.seriesRaw.name, g);
  }
}

// For each series group: sort by explicit part then by date, assign sequential parts
// total = max(actual article count, any frontmatter-specified intended total)
const assignedParts = new Map<string, number>(); // id -> computed part
const seriesTotals = new Map<string, number>();   // name -> intended total

for (const [name, members] of seriesGroups) {
  members.sort((a, b) => {
    const pa = a.seriesRaw?.part, pb = b.seriesRaw?.part;
    if (pa != null && pb != null) return pa - pb;
    if (pa != null) return -1;
    if (pb != null) return 1;
    return a.date.localeCompare(b.date);
  });
  members.forEach((m, i) => assignedParts.set(m.id, i + 1));

  const latestEntry = members[members.length - 1];
  const specifiedTotal = latestEntry.seriesRaw?.total ?? 0;
  seriesTotals.set(name, Math.max(members.length, specifiedTotal));
}

const logUpdated = logUpdatedDates as Record<string, string>;

const logs: Log[] = rawEntries.map((e) => ({
  id: e.id,
  draft: e.draft,
  title: e.title,
  date: e.date,
  updated: logUpdated[e.id],
  kicker: e.kicker,
  words: e.words,
  tags: e.tags,
  image: e.image,
  hook: e.hook,
  devto: e.devto,
  series: e.seriesRaw
    ? { name: e.seriesRaw.name, part: assignedParts.get(e.id)!, total: seriesTotals.get(e.seriesRaw.name)! }
    : undefined,
  noThumb: e.noThumb,
  mentor: e.mentor,
})).sort((a, b) => b.date.localeCompare(a.date));
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
