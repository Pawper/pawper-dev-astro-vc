---
import { PROJECT_CATEGORIES } from '../../data/content';

export function getStaticPaths() {
  return PROJECT_CATEGORIES.map((cat) => ({
    params: { cat: cat.id },
    props: { label: cat.label },
  }));
}

const { cat } = Astro.params;
const { label } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pawper.dev';
const pageUrl = `${siteUrl}/projects/${cat}`;
const description = `${label} projects by Phillip Wessels — Platform Architect & Developer.`;
const redirectUrl = `/?v=entry&cat=projects&entry=${cat}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{label} Projects · Phillip Wessels / CODEX</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={`${label} Projects · Phillip Wessels / CODEX`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="pawper.dev · CODEX" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${label} Projects · Phillip Wessels / CODEX`} />
  <meta name="twitter:description" content={description} />

  <script is:inline define:vars={{ redirectUrl }}>
    window.location.replace(redirectUrl);
  </script>

  <style>
    body { font-family: monospace; background: #0e0e12; color: #f0f0f0; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    a { color: #4ecca3; }
  </style>
</head>
<body>
  <p>Redirecting… <a href={redirectUrl}>Click here if not redirected.</a></p>
</body>
</html>
