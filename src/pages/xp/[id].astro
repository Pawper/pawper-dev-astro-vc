---
import { EXPERIENCES, AGENDA_EVENTS } from '../../data/content';
import ogImagesRaw from '../../data/og-images.json';

const ogImages = ogImagesRaw as Record<string, string>;

const LONE_URL_RE = /^<?(https?:\/\/[^\s>]+)>?$/;

export function getStaticPaths() {
  const all = [
    ...EXPERIENCES,
    ...AGENDA_EVENTS.filter((e) => !EXPERIENCES.some((x) => x.id === e.id)),
  ];
  return all.map((e) => ({
    params: { id: e.id },
    props: {
      title: e.title,
      organization: e.organization ?? '',
      description: e.description ?? '',
      category: e.category,
      datetimeStart: e.datetimeStart,
    },
  }));
}

const { id } = Astro.params;
const { title, organization, description, category, datetimeStart } = Astro.props;

/** Clean description — skip bare URLs that are only useful inside the SPA */
function ogDesc(raw: string, org: string, cat: string): string {
  if (!raw) return `${cat} · ${org}`;
  const first = raw.split('\n')[0].trim();
  if (LONE_URL_RE.test(first)) return `${cat} · ${org}`;
  return raw.length > 200 ? raw.slice(0, 197) + '…' : raw;
}

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pawper.dev';
const pageUrl = `${siteUrl}/xp/${id}`;
const ogTitle = organization ? `${title} · ${organization}` : title;
const ogDescription = ogDesc(description, organization, category);
const ogImage = ogImages[`xp/${id}`] ?? '';

const isAgenda = !!datetimeStart;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{ogTitle} · Phillip Wessels / CODEX</title>
  <meta name="description" content={ogDescription} />
  <link rel="canonical" href={pageUrl} />

  <meta property="og:type" content={isAgenda ? 'event' : 'profile'} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:site_name" content="pawper.dev · CODEX" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  {ogImage && <meta property="og:image:alt" content={ogTitle} />}

  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {ogImage && <meta name="twitter:image:alt" content={ogTitle} />}

  <script is:inline define:vars={{ id }}>
    window.location.replace('/?modal=experience&id=' + encodeURIComponent(id));
  </script>

  <style>
    body { font-family: monospace; background: #0e0e12; color: #f0f0f0; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    a { color: #4ecca3; }
  </style>
</head>
<body>
  <p>Redirecting… <a href={`/?modal=experience&id=${encodeURIComponent(id)}`}>Click here if not redirected.</a></p>
</body>
</html>
