    .skills-grid { font-size: 11.4px; gap: 3px 14px; }
    .job-title-row { margin-bottom: 4px; }
    .job { margin-bottom: 10px; }
    .sub-role { margin-top: 9px; padding-top: 9px; }
    /* Keep headings with the content that follows them and bullets whole across page breaks. */
    .section-label, .job-company, .job-title-row { break-after: avoid; page-break-after: avoid; }
    li, .edu-line, .edu-school { break-inside: avoid; page-break-inside: avoid; }
    a { color: #666 !important; text-decoration: none !important; }
  }
