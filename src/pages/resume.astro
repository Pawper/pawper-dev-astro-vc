---
// Resume page — source of truth for /resume and /resume.pdf
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phillip Wessels — Resume</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root { color-scheme: light; }
  html, body {
    background: #eeece7;
    min-height: 100%;
  }
  body {
    font-family: 'Jost', sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    color: #1a1a1a;
    padding: 3rem 2rem 5rem;
  }
  .page {
    max-width: 780px;
    margin: 0 auto;
    background: #fff;
    padding: 2.5rem 3rem;
    box-shadow: 0 2px 24px rgba(0,0,0,0.10);
  }
  .name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: #1a1a1a;
  }
  .title {
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #666;
    margin-top: 5px;
  }
  .contact {
    font-size: 12px;
    color: #666;
    margin-top: 7px;
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
  .contact a { color: #666; text-decoration: none; }
  .contact a:hover { color: #1a1a1a; }
  hr {
    border: none;
    border-top: 0.5px solid #d0d0d0;
    margin: 18px 0;
  }
  .section-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 10px;
  }
  .summary {
    font-size: 13.5px;
    color: #1a1a1a;
    line-height: 1.75;
    font-weight: 300;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 5px 18px;
    font-size: 12.5px;
  }
  .skill-cat { font-weight: 500; color: #1a1a1a; white-space: nowrap; padding-top: 1px; }
  .skill-val { color: #555; font-weight: 300; }
  .job { margin-bottom: 22px; }
  .job-company { font-weight: 500; font-size: 14px; color: #1a1a1a; }
  .job-company-sub { font-weight: 300; font-size: 12px; color: #555; }
  .job-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin-top: 2px;
    margin-bottom: 8px;
  }
  .job-title { font-size: 12.5px; color: #666; font-weight: 300; font-style: italic; }
  .job-dates { font-size: 11.5px; color: #888; white-space: nowrap; }
  ul { padding-left: 14px; }
  li {
    font-size: 13px;
    font-weight: 300;
    color: #1a1a1a;
    margin-bottom: 5px;
    line-height: 1.65;
  }
  li::marker { color: #aaa; font-size: 10px; }
  .sub-role {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 0.5px solid #e0e0e0;
  }
  .edu-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 12px;
    font-size: 13px;
  }
  .edu-degree { font-weight: 500; color: #1a1a1a; }
  .edu-year { font-size: 11.5px; color: #888; }
  .edu-school { color: #666; font-weight: 300; font-size: 12.5px; margin-top: 2px; }

  @media (max-width: 640px) {
    html, body { background: #fff; padding: 0; }
    .page { box-shadow: none; padding: 1.5rem 1.25rem; }
    .skills-grid { grid-template-columns: 1fr; gap: 10px 0; }
    .skill-cat { margin-bottom: -6px; }
    .job-title-row { flex-direction: column; gap: 0; }
    .job-dates { margin-top: -2px; }
    .edu-line { flex-direction: column; gap: 0; }
  }

  @media print {
    @page { margin: 0.75in 0.85in; size: letter; }
    html, body { background: #fff; padding: 0; }
    .page { box-shadow: none; padding: 0; max-width: 100%; font-size: 11.5px; }
    .name { font-size: 30px; }
    li { margin-bottom: 3px; }
    .job { margin-bottom: 16px; }
    a { color: #666 !important; text-decoration: none !important; }
  }
</style>
</head>
<body>
