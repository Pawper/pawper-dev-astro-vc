  .skill-cat { font-weight: 500; color: #1a1a1a; white-space: nowrap; padding-top: 1px; }
  .skill-val { color: #555; font-weight: 300; }
  .job { margin-bottom: 18px; }
  .job-company { font-weight: 500; font-size: 14px; color: #1a1a1a; }
  .job-company-sub { font-weight: 300; font-size: 12px; color: #555; }
  .job-title-row { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 2px 12px; margin-top: 2px; margin-bottom: 7px; }
  .job-title { font-size: 12.5px; color: #666; font-weight: 300; font-style: italic; }
  .job-dates { font-size: 11.5px; color: #888; white-space: nowrap; }
