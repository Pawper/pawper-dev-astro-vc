---
import { PROJECTS } from '../../data/content';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({
    params: { id: p.id },
    props: {
      title: p.title,
      description: p.description,
      image: p.image ?? '',
      githubURL: p.githubURL ?? '',
      webURL: p.webURL ?? '',
      readme: p.readme ?? '',
    },
  }));
}

const { id } = Astro.params;
const { title, description, image, githubURL, webURL, readme } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pawper.dev';
const pageUrl = `${siteUrl}/p/${id}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Phillip Wessels / CODEX</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="pawper.dev · CODEX" />
  {image && <meta property="og:image" content={image} />}
  {image && <meta property="og:image:alt" content={title} />}

  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={image} />}

  <script is:inline define:vars={{ id }}>
    window.location.replace('/?modal=project&id=' + encodeURIComponent(id));
  </script>

  <style>
    body { font-family: monospace; background: #0e0e12; color: #f0f0f0; margin: 0; padding: 0; }
    #redirect { display: flex; align-items: center; justify-content: center; padding: 60px 20px; }
    a { color: #4ecca3; }
    article { max-width: 720px; margin: 0 auto; padding: 0 24px 60px; }
    article h1 { font-size: 26px; font-weight: 600; margin: 0 0 10px; }
    article .desc { font-size: 15px; line-height: 1.6; margin: 0 0 20px; }
    article .links { display: flex; gap: 24px; margin-bottom: 32px; font-size: 14px; }
    article pre { white-space: pre-wrap; line-height: 1.75; font-size: 14px; margin: 0; font-family: inherit; }
  </style>
</head>
<body>
  <div id="redirect">
    <p>Redirecting… <a href={`/?modal=project&id=${encodeURIComponent(id)}`}>Click here if not redirected.</a></p>
  </div>
  <article>
    <h1>{title}</h1>
    <p class="desc">{description}</p>
    <div class="links">
      {webURL && <a href={webURL}>Visit ↗</a>}
      {githubURL && <a href={githubURL}>View Source ↗</a>}
    </div>
    {readme && <pre>{readme}</pre>}
  </article>
</body>
</html>
