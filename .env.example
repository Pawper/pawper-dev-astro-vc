# Copy to .env and fill in real values. Set the same vars in the Netlify
# dashboard (Site settings → Environment variables) for production builds.

GITHUB=
CLOUDINARY_URL=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
DEVTO_API_KEY=

# reCAPTCHA v3 — register a site (type: reCAPTCHA v3) at
# https://www.google.com/recaptcha/admin to obtain these keys.
#   PUBLIC_RECAPTCHA_SITE_KEY  exposed to the browser; needed at build time.
#   RECAPTCHA_SECRET_KEY       server-only; used by the contact function at runtime.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
